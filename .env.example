# ── Discord ──────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your-discord-bot-token
DISCORD_USER_ID_ORIOL=123456789
DISCORD_USER_ID_ARNAU=123456789
DISCORD_USER_ID_ADAM=123456789
DISCORD_BLOCKERS_CHANNEL_ID=123456789
DISCORD_ANNOUNCEMENTS_CHANNEL_ID=123456789

# ── Notion ────────────────────────────────────────────────────────────────────
NOTION_TOKEN=secret_your_notion_integration_token
NOTION_TASKS_DB_ID=your-tasks-database-id
NOTION_DAILY_LOGS_DB_ID=your-daily-logs-database-id
NOTION_STREAKS_DB_ID=your-streaks-database-id
NOTION_MEETINGS_DB_ID=your-meetings-database-id
# optional:
# NOTION_SETTINGS_DB_ID=your-settings-database-id

# ── LLM backend (Groq default) ────────────────────────────────────────────────
# Recommended: Groq (hosted, no GPU required)
LLM_API_STYLE=openai
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=gsk_your_groq_api_key
# Optional failover keys. The bot tries them in order when a request fails.
# LLM_API_KEY_2=gsk_second_groq_api_key
# LLM_API_KEY_3=gsk_third_groq_api_key
# Alternative format:
# LLM_API_KEYS=gsk_primary,gsk_second,gsk_third
